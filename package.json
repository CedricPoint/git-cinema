  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "git",
    "visualization",
    "gource",
    "animation",
    "history",
    "cli",
    "video"
  ],
  "author": "CedricPoint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CedricPoint/git-cinema.git"
  }
